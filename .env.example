# Copy to .env and fill in, or export these in your shell. `.env` is git-ignored and this file
# holds no values on purpose: this repository is public, and bucket, endpoint and hostname all
# identify the Cloudflare account they belong to.
#
# The infrastructure module that creates all four prints them: `just deploy-env` in home/weather-cards.

# The R2 bucket the site is uploaded into.
WEATHER_CARDS_BUCKET=

# S3-compatible endpoint for that bucket. The `.eu` in it is the bucket's EU jurisdiction, not a region.
WEATHER_CARDS_S3_ENDPOINT=

# Where the site is served. The render reads the previous run's manifest from here, so that a place
# whose sources fail keeps the charts it had. Optional — without it such a place is simply left out.
WEATHER_CARDS_HOSTNAME=

# R2 API token with Object Read & Write on that bucket only, as an S3 access key pair.
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create Account API Token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
